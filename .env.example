# SkillSync Environment Variables
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0

APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars

# ── Database ──────────────────────────────────────────────────────────
# Local SQLite (default). Replace with postgresql+asyncpg://... for PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./skillsync.db

# ── GitHub Integration ────────────────────────────────────────────────
# Personal Access Token with 'repo' (read-only) and 'read:user' scopes.
# Optional for public repos, recommended for higher rate limits.
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_personal_access_token_here

# GitHub Webhook Secret configured in repo Settings -> Webhooks
GITHUB_WEBHOOK_SECRET=your_webhook_hmac_secret_here

# ── AI Provider: Google Gemini ────────────────────────────────────────
# API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Operational Flags ─────────────────────────────────────────────────
# Set to 'false' in production when real GitHub API & Gemini API are configured.
# Set to 'true' for local offline testing with built-in test doubles.
USE_TEST_DOUBLES=false
GITHUB_TIMEOUT_SECONDS=10.0
AI_TIMEOUT_SECONDS=30.0

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (e.g. production domain)
CORS_ORIGINS=http://localhost:5173,https://yourdomain.com
